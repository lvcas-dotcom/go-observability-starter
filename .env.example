# Copy to .env and adjust. Docker Compose picks it up automatically.
# .env is gitignored — keep real webhook URLs and tokens there, not in the
# committed YAML.

# Image tag and the version reported by app_build_info.
VERSION=dev

# Set to false to stop the synthetic traffic generator and drive the stack
# with real requests instead.
DEMO_TRAFFIC=true

# debug | info | warn | error
LOG_LEVEL=info

# Fraction of requests to trace, 0.0 to 1.0. 1.0 is fine for a demo; in
# production this is the knob that keeps your tracing bill sane.
TRACE_SAMPLE_RATE=1.0

# How long Prometheus keeps samples on disk.
PROMETHEUS_RETENTION=24h

# Host ports. Change these if something already owns them locally.
APP_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_PORT=12345
