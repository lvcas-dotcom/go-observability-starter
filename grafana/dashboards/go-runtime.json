{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Entranhas do runtime do Go: goroutines, heap, GC e recursos do processo. Toda métrica aqui vem de graça com o client_golang.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    { "title": "Visão Geral do App Go", "type": "link", "url": "/d/go-app-overview", "icon": "external link", "tags": [] }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Goroutines",
      "description": "Linha que só sobe e nunca desce é o formato clássico de vazamento de goroutine.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "go_goroutines{job=\"go-app\"}", "legendFormat": "goroutines" }
      ]
    },
    {
      "type": "stat",
      "title": "Heap em uso",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "go_memstats_heap_inuse_bytes{job=\"go-app\"}", "legendFormat": "heap" }
      ]
    },
    {
      "type": "stat",
      "title": "Memória residente",
      "description": "O que o SO acha que o processo custa. É esse número que faz o container levar OOM kill.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "process_resident_memory_bytes{job=\"go-app\"}", "legendFormat": "rss" }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "time() - process_start_time_seconds{job=\"go-app\"}",
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Goroutines e threads do SO",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "go_goroutines{job=\"go-app\"}", "legendFormat": "goroutines" },
        { "refId": "B", "editorMode": "code", "expr": "go_threads{job=\"go-app\"}", "legendFormat": "threads do SO" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Composição da memória",
      "description": "Heap em uso vs. o alvo do GC do runtime vs. o que o SO realmente reservou.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "go_memstats_heap_inuse_bytes{job=\"go-app\"}", "legendFormat": "heap em uso" },
        { "refId": "B", "editorMode": "code", "expr": "go_memstats_stack_inuse_bytes{job=\"go-app\"}", "legendFormat": "stack em uso" },
        { "refId": "C", "editorMode": "code", "expr": "go_memstats_next_gc_bytes{job=\"go-app\"}", "legendFormat": "alvo do próximo GC" },
        { "refId": "D", "editorMode": "code", "expr": "process_resident_memory_bytes{job=\"go-app\"}", "legendFormat": "residente (RSS)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pausas do GC por quantil",
      "description": "Duração das pausas stop-the-world. Quando o p99 dispara mas o handler não fez nada lento, olhe aqui primeiro.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 5,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "go_gc_duration_seconds{job=\"go-app\"}",
          "legendFormat": "quantil {{quantile}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Taxa de alocação e ciclos de GC",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "bytes alocados/s" },
            "properties": [{ "id": "unit", "value": "Bps" }]
          },
          {
            "matcher": { "id": "byName", "options": "ciclos de GC/s" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "rate(go_memstats_alloc_bytes_total{job=\"go-app\"}[$__rate_interval])",
          "legendFormat": "bytes alocados/s"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "rate(go_gc_duration_seconds_count{job=\"go-app\"}[$__rate_interval])",
          "legendFormat": "ciclos de GC/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU e file descriptors",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cores de CPU usados" },
            "properties": [{ "id": "unit", "value": "percentunit" }]
          },
          {
            "matcher": { "id": "byName", "options": "file descriptors abertos" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "rate(process_cpu_seconds_total{job=\"go-app\"}[$__rate_interval])",
          "legendFormat": "cores de CPU usados"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "process_open_fds{job=\"go-app\"}",
          "legendFormat": "file descriptors abertos"
        }
      ]
    }
  ],
  "preload": false,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["go", "observabilidade", "runtime"],
  "templating": {
    "list": [
